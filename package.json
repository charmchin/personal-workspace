{
  "name": "personal-workbench",
  "private": true,
  "version": "0.1.5",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "app:build": "node scripts/build-app.mjs",
    "app:privacy": "node scripts/scan-app-privacy.mjs",
    "app:privacy:test": "node --test scripts/build-privacy.node-test.mjs",
    "test": "vitest run --exclude '.local-docs/**'",
    "test:watch": "vitest --exclude '.local-docs/**'",
    "notices:update": "node scripts/third-party-notices.mjs",
    "notices:check": "node scripts/third-party-notices.mjs --check",
    "notices:verify": "node scripts/third-party-notices.mjs --verify",
    "notices:test": "node --test scripts/third-party-notices.node-test.mjs",
    "preview": "vite preview",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2",
    "@tanstack/react-table": "^8.21.3",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.542.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "recharts": "^3.1.2",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "jsdom": "^26.1.0",
    "typescript": "~5.8.3",
    "vite": "^7.0.4",
    "vitest": "^4.1.11",
    "@tauri-apps/cli": "^2"
  }
}
